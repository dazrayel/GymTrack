<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            TestActivity is declared in the debug sourceset so instrumented tests can launch
            it from the main app process (com.gymtrack), avoiding process-mismatch errors.
        -->
        <activity
            android:name="com.gymtrack.TestActivity"
            android:exported="false" />
    </application>
</manifest>
